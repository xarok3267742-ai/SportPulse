{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sport Pulse Event Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "source",
    "generatedAt",
    "validUntil",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$"
    },
    "source": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0
    },
    "validUntil": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sport",
        "tournament",
        "region",
        "match",
        "startAt",
        "focus",
        "note",
        "tags",
        "assessment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{3,64}$"
        },
        "sport": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "tournament": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "match": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "startAt": {
          "type": "integer",
          "minimum": 0
        },
        "focus": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "tags": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "lineup",
        "load",
        "context",
        "sources"
      ],
      "properties": {
        "form": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "lineup": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "load": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "context": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "sources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
